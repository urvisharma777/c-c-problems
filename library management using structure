#include<stdio.h>
struct Book
{
    int Bid;
    char Bname[40];
    char Bauthor[38];
    float Bprice;

};
int main()
{
    struct Book B[27];
    int n,i,max=0;
    float sum=0;
    printf("enter no of books:");
    scanf("%d",&n);
    for(i=0;i<n;i++)
    {
         printf("Book id:");
        scanf("%d",&B[i].Bid);
        printf("Book name:");
        scanf("%s",B[i].Bname);
        printf("Author's name:");
        scanf("%s",B[i].Bauthor);
        printf("Price of book:");
        scanf("%f",&B[i].Bprice);
        sum=sum+B[i].Bprice;
        if(B[i].Bprice>B[max].Bprice)
            max=i;
    }
    printf("book records:");
    for(i=0;i<n;i++)
    {
      printf("%d %s %f\n",B[i].Bid,B[i].Bname,B[i].Bprice);
    }
    printf("Average price =%f\n",sum/n);
    return 0;
}
